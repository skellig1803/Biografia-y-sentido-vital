# DEEPSEEK_API_KEY: Clave de API de DeepSeek para generación biográfica y lectura integral.
# Obtén tu clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# GEMINI_API_KEY: Respaldo secundario opcional.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Polar.sh Payments & Billing (Merchant of Record - https://polar.sh)
# Tu organización, token de acceso y clave secreta de webhooks
POLAR_ORGANIZATION_SLUG="tu-organizacion"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# 1. Paquetes de Créditos para "Faro Biográfico" (Reportes con IA)
POLAR_CHECKOUT_URL_SINGLE=""         # 1 Reporte de Trayectoria Vital ($3.99 USD)
POLAR_CHECKOUT_URL_PACK5=""          # Pack 5 Reportes de Análisis ($14.99 USD)
POLAR_CHECKOUT_URL_PACK15=""         # Pack Profesional 15 Reportes ($29.99 USD)

# 2. Servicios Continuos y Consultoría
POLAR_CHECKOUT_URL_FARO_DIARIO=""    # Faro Diario - Suscripción Matutina ($7.99 USD/mes)
POLAR_CHECKOUT_URL_RECTIFICACION=""  # Rectificación Biográfica de Carta Natal ($80.00 USD)
POLAR_CHECKOUT_URL_CONSULTAS=""      # Consultas Privadas Individuales (Enlace de cobro acordado)

# Agenda externa para Consultas Privadas (WhatsApp / Cal.com):
CONSULTING_CALENDAR_URL="https://cal.com/tu-usuario"

# Supabase / PostgreSQL Database Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Monitorización de Errores y Alertas al Desarrollador (Anti-Saturación / Deduplicado)
# Opcional: Webhook de Discord, Slack o endpoint HTTP para recibir alertas de fallos en IA
DEV_ALERT_WEBHOOK_URL=""
# Ventana de enfriamiento en minutos para agrupar errores de la misma causa (por defecto 15 min)
DEV_ERROR_COOLDOWN_MINUTES="15"

# ========================================================
# Google Assistant / Google Actions Integration
# ========================================================
# ID del proyecto en Google Cloud Console (donde están configuradas las Actions)
GOOGLE_ACTIONS_PROJECT_ID=""

# Secreto compartido para validar que los webhooks vienen de Google Actions
# Configura este mismo valor en el header x-assistant-secret de Google Actions Console
ASSISTANT_WEBHOOK_SECRET=""

# ========================================================
# Pre-generación de Audio Diario (Scheduler)
# ========================================================
# Secreto para proteger el endpoint POST /api/scheduler/run-daily
# Usa Bearer token: Authorization: Bearer {SCHEDULER_SECRET}
SCHEDULER_SECRET=""

# Nombre del bucket en Supabase Storage para audios diarios pregenerados
# Crear el bucket manualmente en Supabase > Storage > New bucket > "daily-audio" (privado)
SUPABASE_STORAGE_BUCKET="daily-audio"
