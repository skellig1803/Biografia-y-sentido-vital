# DEEPSEEK_API_KEY: Clave de API de DeepSeek para generación biográfica y lectura integral.
# Obtén tu clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# GEMINI_API_KEY: Respaldo secundario opcional.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Polar.sh Payments & Billing (Merchant of Record - https://polar.sh)
# Tu organización, token de acceso y clave secreta de webhooks
POLAR_ORGANIZATION_SLUG="tu-organizacion"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# 1. Paquetes de Créditos para "Faro Biográfico" (Reportes con IA)
POLAR_CHECKOUT_URL_SINGLE=""         # 1 Reporte de Trayectoria Vital ($3.99 USD)
POLAR_CHECKOUT_URL_PACK5=""          # Pack 5 Reportes de Análisis ($14.99 USD)
POLAR_CHECKOUT_URL_PACK15=""         # Pack Profesional 15 Reportes ($29.99 USD)

# 2. Servicios Continuos y Consultoría
POLAR_CHECKOUT_URL_FARO_DIARIO=""    # Faro Diario - Suscripción Matutina ($7.99 USD/mes)
POLAR_CHECKOUT_URL_RECTIFICACION=""  # Rectificación Biográfica de Carta Natal ($80.00 USD)
POLAR_CHECKOUT_URL_CONSULTAS=""      # Consultas Privadas Individuales (Enlace de cobro acordado)

# Agenda externa para Consultas Privadas (WhatsApp / Cal.com):
CONSULTING_CALENDAR_URL="https://cal.com/tu-usuario"

# Supabase / PostgreSQL Database Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
