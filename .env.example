# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Lemon Squeezy Payments & Billing
# Configure your Lemon Squeezy Store ID, API Key, Webhook Secret, and Checkout URLs
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Direct Lemon Squeezy Checkout URLs for each package (from your Lemon Squeezy Products/Variants):
LEMONSQUEEZY_CHECKOUT_URL_SINGLE=""
LEMONSQUEEZY_PACK5_URL=""
LEMONSQUEEZY_CHECKOUT_URL_PACK15=""

# Supabase / PostgreSQL Database Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
