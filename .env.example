# GEMINI_API_KEY: Motor principal para síntesis biográfica y generación de voz (TTS).
GEMINI_API_KEY=""
# Opcional: forzar una versión específica de Gemini (si está vacío, elige la más nueva usable automáticamente)
GEMINI_MODEL_OVERRIDE=""
GEMINI_TTS_MODEL_OVERRIDE=""

# DEEPSEEK_API_KEY: Respaldo automático en caso de fallo/cuota de Gemini.
# Obtén tu clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY=""

# APP_URL: URL pública principal en producción (ej. https://www.farobiografico.com).
APP_URL="https://www.farobiografico.com"

# ========================================================
# Pasarela Principal: PayPal Business (Global)
# ========================================================
# Obtén tu Client ID y Secret en https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="live" # 'sandbox' para pruebas, 'live' para producción

# 1. Enlace o ID del Plan de Suscripción para Faro Diario ($7.99 USD/mes)
# Creado en PayPal > Herramientas de Pago > Suscripciones > Crear Plan
PAYPAL_CHECKOUT_URL_FARO_DIARIO="https://www.paypal.com/webapps/billing/plans/subscribe?plan_id=..."
PAYPAL_PLAN_ID_FARO_DIARIO=""

# 2. Enlaces directos o configuración de Checkout para Paquetes de Créditos
PAYPAL_CHECKOUT_URL_SINGLE=""         # 1 Reporte de Trayectoria Vital ($3.99 USD)
PAYPAL_CHECKOUT_URL_PACK5=""          # Pack 5 Reportes de Análisis ($14.99 USD)
PAYPAL_CHECKOUT_URL_PACK15=""         # Pack Profesional 15 Reportes ($29.99 USD)
PAYPAL_CHECKOUT_URL_RECTIFICACION=""  # Rectificación Biográfica de Carta Natal ($80.00 USD)

# ========================================================
# Pasarela Local / Paralela: Payphone (Ecuador)
# ========================================================
# Opción A: Token de Desarrollador en https://developer.payphone.app
PAYPHONE_TOKEN=""

# Opción B: Links directos de cobro de Payphone (generados en la app o web)
PAYPHONE_URL_SINGLE=""                # 1 Reporte ($3.99 USD)
PAYPHONE_URL_PACK5=""                 # Pack 5 ($14.99 USD)
PAYPHONE_URL_PACK15=""                # Pack Profesional 15 ($29.99 USD)
PAYPHONE_URL_FARO_DIARIO=""           # Faro Diario ($7.99 USD/mes)
PAYPHONE_URL_RECTIFICACION=""         # Rectificación ($80.00 USD)
# (Las Consultas Privadas se coordinan de forma directa e inmediata vía WhatsApp a +593999429478)

# Supabase / PostgreSQL Database Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Monitorización de Errores y Alertas al Desarrollador (Anti-Saturación / Deduplicado)
# Opcional: Webhook de Discord, Slack o endpoint HTTP para recibir alertas de fallos en IA
DEV_ALERT_WEBHOOK_URL=""
# Ventana de enfriamiento en minutos para agrupar errores de la misma causa (por defecto 15 min)
DEV_ERROR_COOLDOWN_MINUTES="15"

# ========================================================
# Faro Diario - Pre-generación de Audio Diario (Scheduler)
# ========================================================
# Secreto para proteger el endpoint /api/scheduler/run-daily (y Vercel Cron Jobs)
# Usa Bearer token: Authorization: Bearer {SCHEDULER_SECRET}
SCHEDULER_SECRET=""
CRON_SECRET=""

# Nombre del bucket en Supabase Storage para audios diarios pregenerados
# Crear el bucket manualmente en Supabase > Storage > New bucket > "daily-audio" (privado)
SUPABASE_STORAGE_BUCKET="daily-audio"

# ========================================================
# Entrega Automática por WhatsApp (Meta WhatsApp Cloud API)
# ========================================================
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Opcional: plantilla aprobada en Meta (para envíos fuera de ventana de 24h)
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="es"

# IDs opcionales de productos en Polar para verificación exacta de créditos en webhooks
POLAR_PRODUCT_ID_PACK1=""
POLAR_PRODUCT_ID_PACK5=""
POLAR_PRODUCT_ID_PACK15=""
POLAR_PRODUCT_ID_FARO_DIARIO=""
